rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Funciones auxiliares ----
    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ---- Usuarios: cada uno solo su propio documento ----
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isOwner(uid);
      allow update: if isOwner(uid) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']);
      allow delete: if isOwner(uid);
    }

    // ---- Consentimientos: solo el dueño, inmutables ----
    match /consents/{docId} {
      allow read: if isOwner(resource.data.uid);
      allow create: if isOwner(request.resource.data.uid);
      allow update, delete: if false;
    }

    // ---- Matrículas ----
    match /enrollments/{docId} {
      allow read: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isOwner(request.resource.data.uid);
      allow update: if isOwner(resource.data.uid) || isAdmin();
      allow delete: if isOwner(resource.data.uid) || isAdmin();
    }

    // ---- Reuniones Zoom: alumnos solo lectura de las suyas, admin total ----
    match /meetings/{docId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow write: if isAdmin();
    }

    // ---- Audit logs: SOLO escritura server-side (inmutable) ----
    match /audit_logs/{docId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // ---- Contacto público ----
    match /contact_submissions/{docId} {
      allow create: if isSignedIn() || true; // spam controlado por rate limit en server
      allow read: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // ---- Denegar todo lo demás por defecto ----
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
