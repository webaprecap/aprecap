rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Funciones auxiliares ----
    function isSignedIn() {
      return request.auth != null;
    }
    function userDoc() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }
    function userExists() {
      return exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }
    function isAdmin() {
      return isSignedIn() && userExists() && userDoc().data.rol in ['admin', 'superadmin'];
    }
    function isTeacher() {
      return isSignedIn() && userExists() && userDoc().data.rol == 'profesor';
    }
    function isSuperAdmin() {
      return isSignedIn() && userExists() && userDoc().data.rol == 'superadmin';
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ---- Usuarios: cada uno su documento; admin gestiona todo ----
    match /usuarios/{userId} {
      allow get: if isSignedIn() && (userId == request.auth.uid ||
                    resource.data.email == request.auth.token.email || isAdmin());
      allow list: if isSignedIn();
      allow create: if isSignedIn() && (
        isAdmin() || (
          userId == request.auth.uid && request.resource.data.email == request.auth.token.email &&
          (request.resource.data.rol == 'alumno' || request.resource.data.rol == 'profesor' ||
            (request.resource.data.rol == 'admin' && request.auth.token.email == 'web.aprecap@gmail.com') ||
            (request.resource.data.rol == 'superadmin' && request.auth.token.email == 'contacto.digitalup@gmail.com'))
        ));
      allow update: if isSignedIn() && (
        isAdmin() || ( userId == request.auth.uid &&
          request.resource.data.rol == resource.data.rol &&
          request.resource.data.activo == resource.data.activo &&
          request.resource.data.email == resource.data.email ) );
      allow delete: if isAdmin() || (userId == request.auth.uid && resource.data.email == request.auth.token.email);
    }

    // ---- Solicitudes de acceso: dueño lee/crea; admin gestiona ----
    match /solicitudes/{solicitudId} {
      allow read: if isSignedIn() && (resource.data.email == request.auth.token.email || isAdmin());
      allow create: if isSignedIn() && (request.resource.data.email == request.auth.token.email);
      allow update, delete: if isAdmin();
    }

    // ---- Consentimientos: solo el dueño, inmutables (Ley 21.719) ----
    match /consents/{docId} {
      allow read: if isOwner(resource.data.uid) || isAdmin();
      allow create: if isOwner(request.resource.data.uid);
      allow update, delete: if false;
    }

    // ---- Matrículas: alumno lee las suyas; profesor lee todas; admin gestiona ----
    match /enrollments/{docId} {
      allow read: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin() || isTeacher());
      allow create: if isAdmin() && request.resource.data.uid != null;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ---- Reuniones Zoom: alumno lee las suyas; profesor lee todas; admin gestiona ----
    match /meetings/{docId} {
      allow read: if isAdmin() || isTeacher() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow write: if isAdmin();
    }

    // ---- Clases en vivo: solo el admin las crea/inicia/finaliza; alumnos y profesores ven las activas ----
    match /clases/{claseId} {
      allow read: if isSignedIn() && (isAdmin() || isTeacher() || resource.data.estado == 'activa');
      allow write: if isAdmin();
    }

    // ---- Contacto público ----
    match /contact_submissions/{docId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // ---- Audit logs: SOLO lectura admin; escritura server-side (inmutable, Ley 21.663) ----
    match /audit_logs/{docId} {
      allow read: if isAdmin();
      allow create: if false;
      allow update, delete: if false;
    }

    // ---- Denegar todo lo demás por defecto ----
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
