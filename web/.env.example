# ============================================
# OTEC APRECAP - Variables de entorno
# Copia este archivo a .env y completa los valores.
# NUNCA subir .env a Git (ya está en .gitignore).
# ============================================

# --- Moodle (Campus Virtual) ---
MOODLE_URL=https://aprecap.cl/campus
MOODLE_USER=admin
# Ojo: usa comillas simples si la pass contiene $ (expansión de dotenv)
MOODLE_PASS=''
# Token de web services (se habilita desde el campus con el host)
MOODLE_TOKEN=

# --- Host del servidor ---
HOST_USER=
HOST_PASS=

# --- Gmail del cliente (enlazado a todo) ---
CLIENT_GMAIL=
GMAIL_PASS=

# --- Firebase (públicas con NEXT_PUBLIC_) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Sanity (públicas con NEXT_PUBLIC_) ---
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# --- Superadmin (email de Digital UP SpA) ---
NEXT_PUBLIC_SUPERADMIN_EMAIL=contacto.digitalup@gmail.com
# MFA obligatorio para admin/profesor (false = desactivado para pruebas)
NEXT_PUBLIC_MFA_REQUIRED=false

# --- Zoom (server-side, app Server-to-Server OAuth) ---
ZOOM_USER=
ZOOM_PASS=
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
